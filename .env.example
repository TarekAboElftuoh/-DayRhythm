# GEMINI_API_KEY: your Google Gemini API key (https://aistudio.google.com/apikey).
# Copy this file to .env.local and fill it in. Never commit a real key — this repo is public.
# For GitHub Actions builds, add it as the repository secret GEMINI_API_KEY instead.
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# APP_URL: Optional hosting domain.
APP_URL="http://localhost:3000"

# Permanent Google link (Calendar/Tasks/Gmail without re-linking every hour).
# Use the OAuth "Web client" Firebase created (Firebase console → Authentication → Sign-in method → Google).
VITE_GOOGLE_OAUTH_CLIENT_ID=""
VITE_GOOGLE_OAUTH_CLIENT_SECRET=""
